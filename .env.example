# =============================================================================
# scfx_dingding 环境变量配置
# 复制此文件为 .env 并修改其中的值：
#   cp .env.example .env
#
# 所有配置项均有默认值，不必须全部填写。
# 但建议至少覆盖以下带 ⚠️ 标记的敏感信息。
# =============================================================================

# ---------- 钉钉应用凭证 ⚠️ ----------
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=

# ---------- 钉钉知识库 ----------
# DINGTALK_UNION_ID=
# DINGTALK_WORKSPACE_ID=
# DINGTALK_PARENT_NODE_ID=

# ---------- AI 助理知识库更新触发 ----------
# RELEARN_ENABLED=true
# RELEARN_HEADLESS=true

# ---------- 钉钉机器人通知 Webhook ⚠️ ----------
# DINGTALK_ROBOT_WEBHOOK=

# ---------- 粮达网 ----------
# LIANGDAWANG_BASE_URL=https://www.liangdawang.com
# LIANGDAWANG_LIST_API=/ldw-portal-mer/v1/analysisReport/list
# LIANGDAWANG_DETAIL_API=/ldw-portal-mer/v1/analysisReport/list

# ---------- 华南粮网 ----------
# HUANAN_WORKSPACE_ID=
# HUANAN_TARGET_NODE_ID=

# ---------- 国家粮食交易中心（海南） ----------
# GRAINMARKET_WORKSPACE_ID=
# GRAINMARKET_TARGET_NODE_ID=
# GRAINMARKET_MARKET_ID=S001031

# ---------- 调度 ----------
# SCHEDULE_INTERVAL_MINUTES=30

# ---------- 数据存储路径 ----------
# 默认 /app/data（对应 docker-compose 中的 scfx_data 卷）
# DB_DIR=/app/data
